# Backend environment variables (template). Copy to .env.
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
PROJECT_NAME=Voda EHRs

DATABASE_URL=postgresql+psycopg://voda:change_me_postgres@localhost:5432/voda_ehrs

JWT_SECRET=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AES_MASTER_KEY=change_me_base64_32_byte_key
PASSWORD_RESET_EXPIRE_MINUTES=30

# Initial admin seeded by `python -m app.seed` (use a valid, non-reserved domain)
INITIAL_ADMIN_EMAIL=admin@vodaehrs.com
INITIAL_ADMIN_PASSWORD=change_me_admin_password
INITIAL_ADMIN_FIRST_NAME=Voda
INITIAL_ADMIN_LAST_NAME=Admin

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change_me_minio_access
MINIO_SECRET_KEY=change_me_minio_secret
MINIO_BUCKET=voda-records
MINIO_SECURE=false

CORS_ORIGINS=http://localhost:5173
