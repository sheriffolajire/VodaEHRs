# Local development configuration for Voda EHRs.
# Copy this file to .env, then replace every change_me value before deployment.


# Application
ENVIRONMENT=development
PROJECT_NAME="Voda EHRs"
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173


# Initial administrator created by `python -m app.seed`.
INITIAL_ADMIN_EMAIL=admin@voda.com
INITIAL_ADMIN_PASSWORD=change_me_local_admin_password
INITIAL_ADMIN_FIRST_NAME=System
INITIAL_ADMIN_LAST_NAME=Administrator

# PostgreSQL (must match the values Docker Compose uses to start the database)
POSTGRES_USER=voda
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=voda_ehrs
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://voda:change_me_postgres@localhost:5432/voda_ehrs

# Authentication
JWT_SECRET=change_me_with_a_random_32_character_minimum_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption. With ALLOW_INSECURE=true, temporary development keys are used.
ALLOW_INSECURE=false 
AES_MASTER_KEY=change_me_base64_encoded_32_byte_key
INSTITUTIONAL_PUBLIC_KEY=change_me_base64_encoded_pem
INSTITUTIONAL_PRIVATE_KEY=change_me_base64_encoded_pem

# MinIO (must match the values Docker Compose uses to start object storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change_me_minio_access
MINIO_SECRET_KEY=change_me_minio_secret
MINIO_BUCKET=voda-ehrs
MINIO_SECURE=false

# Optional. The application falls back to in-memory rate limiting if Redis is unavailable.
# REDIS_URL=redis://localhost:6379/0
